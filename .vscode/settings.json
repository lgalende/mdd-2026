{
  // Resolve bare imports like "@openzeppelin/contracts/token/ERC20/ERC20.sol"
  // against node_modules so go-to-definition (ctrl/cmd+click) works.
  "solidity.packageDefaultDependenciesDirectory": ["node_modules"],
  "solidity.packageDefaultDependenciesContractsDirectory": ["", "src", "contracts"],
  "solidity.remappings": [
    "@openzeppelin/=node_modules/@openzeppelin/",
    "forge-std/=node_modules/forge-std/src/"
  ],
  // Match the solc version pinned in hardhat.config.ts so the editor's
  // diagnostics agree with `npx hardhat compile`.
  "solidity.defaultCompiler": "remote",
  "solidity.compileUsingRemoteVersion": "v0.8.34+commit.80d5c536"
}
