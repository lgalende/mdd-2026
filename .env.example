# Copy to .env and fill in. .env is gitignored; .env.example is committed.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_PRIVATE_KEY=0x<your-private-key>

# Only needed for `npx hardhat verify` on Etherscan.
# Blockscout and Sourcify verification need no key.
ETHERSCAN_API_KEY=<your-etherscan-api-key>
